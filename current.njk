{# MMT-WeatherRibbons: current view. Icon and temperature (same markup as the stock view), #}
{# then a plain-language line and today's ribbon, which wx-forecast.js fills in. #}
{% if current %}
  <div class="wx-cur">
    <div class="flex large type-temp wx-cur-head">
      {% if current.weatherType %}
        <span class="light wi weathericon wi-{{ current.weatherType }}"></span>
      {% endif %}
      <span class="light bright">{{ current.temperature | roundValue | unit("temperature") | decimalSymbol }}</span>
    </div>
    <div class="small bright wx-cur-alerts"></div>
    <div class="xsmall dimmed wx-cur-axis"></div>
    <div class="small wx-cur-chart"></div>
  </div>
{% else %}
  <div class="dimmed light small">{{ "LOADING" | translate }}</div>
{% endif %}
